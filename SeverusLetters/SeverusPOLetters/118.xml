        <note xml:id="n6" target="#a6" n="6">
          <foreign xml:lang="grc">κέλεθσις</foreign>.</note>
        <note xml:id="n7" target="#a7" n="7">
          <foreign xml:lang="grc">εὐσεβής</foreign>.</note>
        <note xml:id="n8" target="#a8" n="8">
          <foreign xml:lang="grc">κράτος</foreign>.</note>
