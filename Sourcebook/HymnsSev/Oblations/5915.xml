        <note xml:id="n1" target="#a1" n="1"><choice><reg/><orig>p. 266, n. 1</orig></choice> Corr. <quote>of God</quote></note>
        <note xml:id="n2" target="#a2" n="2"><choice><reg/><orig>p. 266, n. 2</orig></choice> Corr. <quote>crying</quote>.</note>
