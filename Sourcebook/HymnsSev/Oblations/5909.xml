    <body>
      <div type="work" n="214">
        <pb n="263"/>
        <head>Another by the same <persName>John</persName> on the Resurrection.</head>
        <head>214 — iv.</head>
        <div type="section">
          <ab n="1">Henceforth, death, thy victory is no more; henceforth thy sting appears not<ptr type="noteAnchor" xml:id="a1" target="#n1" n="1"/>; thy dominion [has been<ptr type="noteAnchor" xml:id="a2" target="#n2" n="2"/> dissolved and come to an end; <pb n="264"/> <persName>Christ</persName>, even God, having received and gained victory over thee has risen in glory. Halleluyah!</ab>
        </div>
      </div>
      <noteGrp>
        <note xml:id="n1" target="#a1" n="1"><choice><reg/><orig>p. 263, n. 5</orig></choice> Corr. <quote>no more</quote>.</note>
        <note xml:id="n2" target="#a2" n="2"><choice><reg/><orig>p. 263, n. 6</orig></choice> Corr. <quote>he has</quote>.</note>
      </noteGrp>
