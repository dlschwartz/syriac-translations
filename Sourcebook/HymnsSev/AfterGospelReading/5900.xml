  <text>
    <body>
      <div type="work" n="206">
        <pb n="258"/>
        <head>Another.</head>
        <head>206 — ii — I. — <quote>Purify me with it and I shall be whiter than snow</quote><ptr type="noteAnchor" xml:id="a1" target="#n1" n="1"/>.</head>
        <pb n="259"/>
        <div type="section">
          <ab n="1">Thou hast in thy mercy, <persName>Christ</persName>, God, bathed us in the pure life-giving water of regeneration, and hast made and rendered us sons of thy<ptr type="noteAnchor" xml:id="a2" target="#n2" n="2"/> heavenly Father. By thy<ptr type="noteAnchor" xml:id="a3" target="#n3" n="3"/> same merciful condescension through<ptr type="noteAnchor" xml:id="a4" target="#n4" n="4"/> the reception of thy holy<ptr type="noteAnchor" xml:id="a5" target="#n5" n="5"/> body and thy precious blood remove and blot out every pollution and wickedness of the old man that is hidden in us; and [deliver us, I pray thee<ptr type="noteAnchor" xml:id="a6" target="#n6" n="6"/>.</ab>
        </div>
      </div>
      <noteGrp>
        <note xml:id="n1" target="#a1" n="1"><choice><reg/><orig>p. 258, n. 5</orig></choice> Ps. li, 9.</note>
        <note xml:id="n2" target="#a2" n="2"><choice><reg/><orig>p. 259, n. 1</orig></choice> Corr. <quote>the</quote>.</note>
        <note xml:id="n3" target="#a3" n="3"><choice><reg/><orig>p. 259, n. 1</orig></choice> Corr. <quote>the</quote>.</note>
        <note xml:id="n4" target="#a4" n="4"><choice><reg/><orig>p. 259, n. 2</orig></choice> Corr. <quote>by</quote>.</note>
        <note xml:id="n5" target="#a5" n="5"><choice><reg/><orig>p. 259, n. 3</orig></choice> Corr. <quote>divine</quote>.</note>
        <note xml:id="n6" target="#a6" n="6"><choice><reg/><orig>p. 259, n. 4</orig></choice> Corr. <quote>save, we entreat</quote>.</note>
      </noteGrp>
