        <note xml:id="n5" target="#a5" n="5"><choice><reg/><orig>p. 304, n. 9</orig></choice> Corr. <quote>turnings</quote>.</note>
        <note xml:id="n6" target="#a6" n="6"><choice><reg/><orig>p. 305, n. 1</orig></choice> Corr. <quote>revolve</quote>.</note>
