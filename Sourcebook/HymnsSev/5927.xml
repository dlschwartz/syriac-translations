        <note xml:id="n3" target="#a3" n="3"><choice><reg/><orig>p. 277, n. 2</orig></choice> Corr. <quote>ask, entreating</quote>.</note>
        <note xml:id="n4" target="#a4" n="4"><choice><reg/><orig>p. 277, n. 3</orig></choice> Ps. cxviii, 133.</note>
        <note xml:id="n5" target="#a5" n="5"><choice><reg/><orig>p. 277, n. 4</orig></choice> Corr. <quote>us</quote>.</note>
        <note xml:id="n6" target="#a6" n="6"><choice><reg/><orig>p. 277, n. 5</orig></choice> Ps. xc, 17.</note>
        <note xml:id="n7" target="#a7" n="7"><choice><reg/><orig>p. 277, n. 6</orig></choice> Corr. <quote>high</quote>.</note>
