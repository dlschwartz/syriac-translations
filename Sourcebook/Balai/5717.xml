    <body>
      <div type="work" n="2">
        <pb n="145"/>
        <head>(Further) Rogations of <persName>Mar Balai</persName>.</head>
        <head>Of the Resurrection.</head>
        <lg n="2.1">
          <l n="1">To-day will I choose (to celebrate)</l>
          <l n="2">The joy of the right hand;</l>
          <l n="3">And the mourning and sorrow</l>
          <l n="4">I will choose of the left hand.</l>
          <l n="5">For the King's Son is risen;</l>
          <l n="6">And has made glad His beloved ones.</l>
        </lg>
        <pb n="146"/>
        <lg n="2.2">
          <l n="7"><persName>Annas</persName> is confounded and in contempt,</l>
          <l n="8">And with him <persName>Caiaphas</persName>,</l>
          <l n="9">Because they were made liars</l>
          <l n="10">Before all the people;</l>
          <l n="11">And their seals bear witness</l>
          <l n="12">Against their falsehood.</l>
        </lg>
        <lg n="2.3">
          <l n="13">To-day, behold, the Church</l>
          <l n="14">Rejoices with her children,</l>
          <l n="15">Because her Beloved is risen,</l>
          <l n="16">And has delivered her from error.</l>
          <l n="17">And she is glad and joyous,</l>
          <l n="18">And singeth praises.</l>
        </lg>
      </div>
