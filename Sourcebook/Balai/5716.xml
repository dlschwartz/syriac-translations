  <text>
    <body>
      <div type="work" n="1">
        <pb n="145"/>
        <head>(Further) Rogations of <persName>Mar Balai</persName>.</head>
        <head>Of Priests.</head>
        <lg n="1.1">
          <l n="1">The Priests, Lord, who have ministered to Thee</l>
          <l n="2">In the midst of the holy temple,—</l>
          <l n="3">In that Church of the first-born</l>
          <l n="4">Which is on high let them be written;</l>
          <l n="5">And with <persName>Aaron</persName> the priest</l>
          <l n="6">There let them be in bliss.</l>
        </lg>
        <lg n="1.2">
          <l n="7">In the tabernacles of the just,</l>
          <l n="8">And in the place of the righteous,</l>
          <l n="9">In the Bridechamber of rejoicing,</l>
          <l n="10">There let them be glad;</l>
          <l n="11">Where reigns not</l>
          <l n="12">Suffering and sorrow.</l>
        </lg>
        <lg n="1.3">
          <l n="13">In that Garden of <placeName>Eden</placeName></l>
          <l n="14">Among the trees,</l>
          <l n="15">With <persName>Abraham</persName> and <persName>Isaac</persName></l>
          <l n="16">And <persName>Jacob</persName>, let them rejoice,</l>
          <l n="17">In the place where is no fear</l>
          <l n="18">Nor terror.</l>
        </lg>
        <lg n="1.4">
          <l n="19">Let praise without ceasing</l>
          <l n="20">Ascend continually</l>
          <l n="21">To <persName>Christ</persName> our King,</l>
          <l n="22">Who died for us.</l>
          <l n="23">And to the Priests who ministered to Him</l>
          <l n="24">May He give rest, and raise them up</l>
          <l n="25">On the right hand</l>
          <l n="26">In the Bridechamber of life.</l>
        </lg>
      </div>
