  <text>
    <body>
      <div type="work" n="5">
        <pb n="142"/>
        <head>The Suffrages of <persName>Mar Balai</persName></head>
        <head>Another.</head>
        <lg n="5.1">
          <l n="1">A sea that doth not fail</l>
          <l n="2">Is the riches of His Gift.</l>
          <l n="3">Make them rich that are needy</l>
          <l n="4">With the plenty of Thy Grace.</l>
          <l n="5">And in the day of Thine appearing</l>
          <l n="6">May we rejoice in Thy Bridechamber.</l>
        </lg>
        <lg n="5.2">
          <l n="7">Thy judgment, Lord, is stern,</l>
          <l n="8">And my trespasses are many.</l>
          <l n="9">In Thy mercy, O Thou that art gracious,</l>
          <l n="10">Save Thou the sinners.</l>
          <l n="11">For stern and sore is Thy judgment</l>
          <l n="12">Upon all the wicked.</l>
        </lg>
        <lg n="5.3">
          <l n="13">The weary asketh for water,</l>
          <l n="14">Even as that rich man,</l>
          <l n="15">Who, because he did no mercy,</l>
          <l n="16">Was left without mercy.</l>
          <l n="17">With <persName>Lazarus</persName> hold me worthy</l>
          <l n="18">(To enter) into Thy kingdom.</l>
        </lg>
        <lg n="5.4">
          <l n="19">Thy mercies, O Thou Merciful,</l>
          <l n="20">Pour out upon Thy Church;</l>
          <l n="21">That her children may send up (to Thee)</l>
          <l n="22">Glory and confession,</l>
          <pb n="143"/>
          <l n="23">And to Thy Father honour,</l>
          <l n="24">And loftiness to Thy Spirit.</l>
          <l n="25">And upon us sinners</l>
          <l n="26">Be mercy and loving-kindness.</l>
        </lg>
      </div>
    </body>
