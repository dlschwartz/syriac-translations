    <body>
      <div type="work" n="1">
        <pb n="139"/>
        <head>THE SUFFRAGES OF MAR <persName>BALAI</persName><ptr type="noteAnchor" xml:id="a1" target="#n1" n="1"/></head>
        <head>I. First: Of the Mother of God.</head>
        <lg n="1.1">
          <l n="1">Blessed art thou, <persName>Mary</persName>,</l>
          <l n="2">For by thee were interpreted</l>
          <l n="3">The mysteries and parables</l>
          <l n="4">Which the Seers spoke.</l>
        </lg>
        <lg n="1.2">
          <l n="5"><persName>Moses</persName> depicted thee</l>
          <l n="6">In the Bush and in the Cloud;</l>
          <l n="7">And <persName>Jacob</persName> in the Ladder;</l>
          <l n="8">And <persName>David</persName> in the Ark;</l>
        </lg>
        <pb n="140"/>
        <lg n="1.3">
          <l n="9">And <persName>Ezekiel</persName><ptr type="noteAnchor" xml:id="a2" target="#n2" n="2"/> in the Door</l>
          <l n="10">That was sealed and closed.</l>
          <l n="11">And lo, to-day by thy Childbearing</l>
          <l n="12">Their mysteries are accomplished.</l>
        </lg>
        <lg n="1.4">
          <l n="13">Glory be to the Father,</l>
          <l n="14">Who sent His Only-begotten,</l>
          <l n="15">And He shined forth from <persName>Mary</persName>,</l>
          <l n="16">And delivered us from error,</l>
          <l n="17">And magnified her memorial</l>
          <l n="18">In Heaven and in Earth.</l>
        </lg>
      </div>
      <noteGrp>
        <note xml:id="n1" target="#a1" n="1"><choice><reg/><orig>p. 139, n. 2</orig></choice> <persName>Overbeck</persName>, p 331.</note>
        <note xml:id="n2" target="#a2" n="2"><choice><reg/><orig>p. 140, n. 1</orig></choice> The text has <hi rend="doubleQuote"><persName>Hezekiah</persName></hi> by mistake.</note>
      </noteGrp>
