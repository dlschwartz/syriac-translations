    <body>
      <div type="work" n="3">
        <pb n="141"/>
        <head>The Suffrages of <persName>Mar Balai</persName></head>
        <head>Of Repentance.</head>
        <lg n="3.1">
          <l n="1">When my trespasses stand up</l>
          <l n="2">Before me in the Day of Judgment,</l>
          <l n="3">And manifold encircle me</l>
          <l n="4">My sins to accuse me;</l>
          <l n="5">Speak for me, Thou,</l>
          <l n="6">As an advocate, for in Thee have I taken refuge.</l>
        </lg>
        <lg n="3.2">
          <l n="7">When they come in there</l>
          <l n="8">That were in the ranks of Judges,</l>
          <l n="9">And stand before Thee</l>
          <l n="10">Stripped (and) in clouts;</l>
          <l n="11">Be Thou there my hope,</l>
          <l n="12">For in Thee have I taken refuge.</l>
        </lg>
        <lg n="3.3">
          <l n="13">When they set apart there</l>
          <l n="14">The goats to the left,</l>
          <l n="15">And the lambs to the right hand,</l>
          <l n="16">That they may find pasture in Paradise;</l>
          <l n="17">With Thy lambs account me worthy,</l>
          <l n="18">O heavenly Shepherd.</l>
        </lg>
        <lg n="3.4">
          <l n="19">Glory be to Him who came</l>
          <l n="20">And saved us in His loving-kindness,</l>
          <l n="21">And again is about to come</l>
          <l n="22">And renew His creatures!</l>
          <l n="23">To Him be glory, and to His Father,</l>
          <l n="24">And worship to His Holy Spirit!</l>
        </lg>
      </div>
