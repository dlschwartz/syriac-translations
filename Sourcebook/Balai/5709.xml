    <body>
      <div type="work" n="2">
        <pb n="140"/>
        <head>The Suffrages of <persName>Mar Balai</persName></head>
        <head>Of the Martyrs.</head>
        <lg n="2.1">
          <l n="1">Holy Martyrs,</l>
          <l n="2">Friends of the King's Son,</l>
          <l n="3">Who have triumphed in the contest</l>
          <l n="4">Against the Enemy!—</l>
          <l n="5">And lo, to-day he howls</l>
          <l n="6">Before your urns.</l>
        </lg>
        <lg n="2.2">
          <l n="7">The holy Cross,</l>
          <l n="8">Standard of victory,</l>
          <l n="9">Ye took, O holy ones,</l>
          <l n="10">Into the ranks of battle;</l>
          <l n="11">And the Evil One seeing it</l>
          <l n="12">Was put to shame and confounded before it.</l>
        </lg>
        <lg n="2.3">
          <l n="13">Ye are made a wall</l>
          <l n="14">Unto our land, O holy ones;</l>
          <l n="15">Stand up valiantly,</l>
          <l n="16">Guard our city,</l>
          <l n="17">That the Robber enter not in</l>
          <l n="18">Who is thirsting for our destruction.</l>
        </lg>
        <lg n="2.4">
          <l n="19">Glory be to that Power</l>
          <l n="20">Which strengthened you, O Martyrs,</l>
          <l n="21">So that ye stood in the contest</l>
          <l n="22">Against the Persecutors!—</l>
          <l n="23">And lo, to-day has triumphed</l>
          <l n="24">Your Truth in every region.</l>
          <l n="25">May your prayer stand up for us</l>
          <l n="26">In this world and in that (to come).</l>
        </lg>
      </div>
    </body>
