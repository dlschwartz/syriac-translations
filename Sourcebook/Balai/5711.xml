  <text>
    <body>
      <div type="work" n="4">
        <pb n="141"/>
        <head>The Suffrages of <persName>Mar Balai</persName></head>
        <head>Another.</head>
        <lg n="4.1">
          <l n="1">A wind of sweet spices</l>
          <l n="2">Bloweth in Paradise,</l>
          <l n="3">And an odour of perfumes</l>
          <l n="4">It bringeth to the Victors.</l>
          <l n="5">Take us, <persName>our Saviour</persName>,</l>
          <l n="6">With them into the Bridechamber.</l>
        </lg>
        <lg n="4.2">
          <l n="7">With roses and lilies</l>
          <l n="8">And blossoming flowers</l>
          <l n="9">The Saints are pastured</l>
          <l n="10">In the meadows of Life.</l>
          <l n="11">Blessed is he that is worthy</l>
          <l n="12">With them to be in bliss.</l>
        </lg>
        <pb n="142"/>
        <lg n="4.3">
          <l n="13">The air of the Resurrection</l>
          <l n="14">Distilleth dew for them,</l>
          <l n="15">And (scattereth) fruits of gladness:</l>
          <l n="16">With its beauty it delighteth them.</l>
          <l n="17">Be gracious to me on that day,</l>
          <l n="18"><persName>Jesus</persName> full of loving-kindness.</l>
        </lg>
        <lg n="4.4">
          <l n="19">Glory to Him that became</l>
          <l n="20">Food to satisfy us!</l>
          <l n="21">Glory to Him that became</l>
          <l n="22">Drink to make us glad!—</l>
          <l n="23">Even to Him, now, and to His Father;</l>
          <l n="24">And worship to the Holy Spirit.</l>
        </lg>
      </div>
    </body>
