  <text>
    <body>
      <div type="work" n="7">
        <pb n="143"/>
        <head>The Suffrages of <persName>Mar Balai</persName></head>
        <head>Another.</head>
        <lg n="7.1">
          <l n="1">Give rest to them that are buried,</l>
          <l n="2">O heavenly King,</l>
          <l n="3">And grant abundant forgiveness</l>
          <l n="4">To the faithful departed.</l>
        </lg>
        <pb n="144"/>
        <lg n="7.2">
          <l n="5">That robe wherewith I was clothed,</l>
          <l n="6">Lord, before I had sinned,</l>
          <l n="7">The same put on me, Lord.</l>
          <l n="8">In the day of the Resurrection.</l>
        </lg>
        <lg n="7.3">
          <l n="9">For mercy is dawning,</l>
          <l n="10">And the Resurrection is coming;</l>
          <l n="11">And unto the just is rendered</l>
          <l n="12">The wages of their toils.</l>
        </lg>
        <lg n="7.4">
          <l n="13">Glory to that Voice</l>
          <l n="14">Which calleth to the dead,</l>
          <l n="15">And they rise up incorruptible</l>
          <l n="16">And sing out praises.</l>
        </lg>
      </div>
    </body>
